# ============================================================================
# Environment variable reference (R7).
#
# Placeholders only. Never commit real values, hosts, emails, or key prefixes.
# Values here are EXAMPLES for local development; do not use any of these in
# production. Copy to `.env.local` and fill in real values.
# ============================================================================

# Application environment: development | test | production
NODE_ENV=development

# Canonical HTTPS origin in production (must be https://)
NEXTAUTH_URL=https://your-production-domain.invalid

# NextAuth JWT signing secret. Generate with:
#   openssl rand -base64 32
# Minimum 32 characters.
NEXTAUTH_SECRET=REPLACE_WITH_32_PLUS_CHARACTERS

# Google OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGODB_URI=

# TMDB API key
TMDB_API_KEY=

# Optional: comma-separated IPv4 CIDRs of trusted reverse proxies/CDN edges
# (M-01). When set, the rate limiter walks X-Forwarded-For from the right and
# skips these hops to find the real client IP. Leave empty if your proxy
# sanitizes/appends the client IP (rightmost hop is then used).
TRUSTED_PROXY_CIDRS=

# Gemini API key (only required when AI features are enabled)
GOOGLE_API_KEY=

# ------- Optional Redis (memory fallback is supported if unset) ------------
# One of:
#   REDIS_URL (redis:// or rediss://; rediss:// implies TLS), OR
#   REDIS_HOST + REDIS_PORT (+ optional REDIS_USERNAME / REDIS_PASSWORD / REDIS_TLS)
# Do NOT combine a plain redis:// REDIS_URL with REDIS_TLS=true.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# ------- Retention (R6; bounded 1..3650 days) -------------------------------
HISTORY_RETENTION_DAYS=180
CHAT_RETENTION_DAYS=365